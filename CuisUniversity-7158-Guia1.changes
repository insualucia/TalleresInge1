               assertTypeOfUnaryMessageSend: aSourceCode is: aExpectedType

	self 
		assertTypeOfMessageSend: aSourceCode 
		is: aExpectedType 
		receiverRange: [ :ranges | ranges penultimate ]
		messageRange: [ :ranges | ranges last ]
! !
