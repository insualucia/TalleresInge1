!PossibleSender methodsFor: 'initialization' stamp: 'HAW 4/4/2019 08:49:33'!
                        initializeWithPossibleMessageSends: aPossibleMessageSends 
	
	possibleMessageSends := Set newFrom: aPossibleMessageSends.
