!BaseUnitTest methodsFor: 'test converting' stamp: 'HAW 3/25/2017 19:11:51'!
                           testConvertToBaseUnit

	| unit measure |
	
	unit := BaseUnit named: 'peso'.
	measure := SimpleMeasure amount: 10 unit: unit.
