           testDefaultDirectory
	"
	FileManTest debug: #testDefaultDirectory
	"
	
	| pathComponents |

	self assert: '' asDirectoryEntry =  DirectoryEntry userBaseDirectory.
	pathComponents := '' asDirectoryEntry pathComponents.
