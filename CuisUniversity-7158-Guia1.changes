			(aKeyboardEvent rawMacOptionKeyPressed or: [
				"Windows / Linux standard keystroke"
				aKeyboardEvent controlKeyPressed ])
					ifTrue: [
						newPos := self beginningOfParagraph: newPos-1 ].
			"Mac standard keystroke"
