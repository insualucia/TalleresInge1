!FileEntry methodsFor: 'accessing-stream' stamp: 'jmv 12/19/2024 15:51:26' prior: 16861214!
                              readStreamDo: blockWithArg 
	"Raise FileDoesNotExistException if not found."
	| stream |
	stream := self readStream.
	^ [ blockWithArg value: stream ]
		ensure: [
			stream
				ifNotNil: [ :s | s close ]]! !

