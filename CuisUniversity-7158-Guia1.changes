	timeOfDay := 10:20:30.
	
	self assert: timeOfDay hours equals: 10*TimeUnits hour.
	self assert: timeOfDay minutes equals: 20*TimeUnits minute.
	self assert: timeOfDay seconds equals: 30*TimeUnits second.
