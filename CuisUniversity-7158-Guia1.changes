!Evaluation methodsFor: 'magnitude protocol' overrides: 50450787!
                       < aMagnitude

	^self value < aMagnitude! !
!Evaluation methodsFor: 'magnitude protocol' overrides: 50450791!
                   <= aMagnitude
	"Send value to self so that it is faster and does not pass through #doesNotUnderstand"

	^(aMagnitude < self value) not! !
!Evaluation methodsFor: 'magnitude protocol' overrides: 50450795!
                    > aMagnitude
	"Send value to self so that it is faster and does not pass through #doesNotUnderstand"

	^aMagnitude < self value! !
!Evaluation methodsFor: 'magnitude protocol' overrides: 50450799!
                           >= aMagnitude
	"Send value to self so that it is faster and does not pass through #doesNotUnderstand"

	^(self value < aMagnitude) not! !
!Evaluation methodsFor: 'magnitude protocol' overrides: 50450803!
                    between: min and: max
	"Send value to self so that it is faster and does not pass through #doesNotUnderstand"

	^(min <= self value) and: [self value <= max]! !
!Evaluation methodsFor: 'magnitude protocol' overrides: 50450807!
                             max: aMagnitude
	"Send value to self so that it is faster and does not pass through #doesNotUnderstand.
	Self is given back and not self value to continue maintaining the evaluation"

	self value < aMagnitude ifTrue: [^aMagnitude].
	^self! !
!Evaluation methodsFor: 'magnitude protocol' overrides: 50450811!
            min: aMagnitude
	"Send value to self so that it is faster and does not pass through #doesNotUnderstand.
	Self is given back and not self value to continue maintaining the evaluation"

	self value < aMagnitude ifTrue: [^self].
	^aMagnitude! !
!Evaluation methodsFor: 'magnitude protocol'!
notInclusiveBetween: min and: max
	"Create local variable #val for best performance"

	| val |

	val := self value.
	^val > min and: [val <= max]! !
!Evaluation methodsFor: 'magnitude protocol'!
                             notInclusiveBetween: min andNotInclusive: max
	"Create local variable #val for best performance"

	| val |

	val := self value.
	^val > min and: [val < max]! !
