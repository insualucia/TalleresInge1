!PackageSnapshot methodsFor: 'taking snapshots - methods' stamp: 'HAW 5/12/2025 14:48:19'!
                takeSnapshotOfMethod: aCompiledMethod

	| snapshotOfMethodClass snapshotOfSourceCode snapshotOfMethodSelector |

	snapshotOfMethodClass := self snapshotOf: aCompiledMethod methodClass.
	snapshotOfSourceCode := SourceCodeSnapshot takeOf: aCompiledMethod using: self.

	snapshotOfMethodSelector := snapshotOfMethodClass
		compileSilently: snapshotOfSourceCode
		classified: aCompiledMethod category.

	(snapshotOfMethodClass compiledMethodAt: snapshotOfMethodSelector)
		disableLiveTypingIfInstalled! !
