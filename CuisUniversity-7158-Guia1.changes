     types
	
	| firstEmptyIndex |
	
	firstEmptyIndex := self indexOf: nil ifAbsent: [^ self copy ].
	firstEmptyIndex = 1 ifTrue: [ ^#() ].
	
	^self copyFrom: 1 to: firstEmptyIndex-1 	! !
