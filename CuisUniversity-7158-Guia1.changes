!Unit methodsFor: 'mathematic operations' stamp: 'HAW 11/9/2021 18:29:50'!
                              ^ aPower

	| powered |
	
	aPower = 0 ifTrue: [ ^1 ].
	
	powered := self.
	aPower abs - 1 timesRepeat: [ powered := powered * self ].
	
	^aPower > 0
		ifTrue: [ powered ]
		ifFalse: [ powered reciprocal ]
	 ! !
