!Browser methodsFor: '*DenotativeObject' stamp: 'HAW 6/17/2019 19:56:57'!
     compile: aString receiver: receiver in: evalContext

	| methodNode |

	methodNode := [
		Compiler new
			compileNoPattern: aString
			in: receiver class
			context: evalContext
			notifying: nil
			ifFail: [ ^ nil ]]
				on: OutOfScopeNotification
				do: [ :ex | ex resume: true ].
				
	^ methodNode generate
	
	! !
