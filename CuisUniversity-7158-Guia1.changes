!DecompilerTestFailuresCollector methodsFor: 'accessing' stamp: 'ul 5/6/2015 16:36' overrides: 16977057!
                               assert: aBoolean description: aString resumable: resumableBoolean

	| method |
	aBoolean ifTrue: [ ^self ].
