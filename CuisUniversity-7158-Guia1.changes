timeline
	^ timeline! !
!AnalysisResult methodsFor: 'timeline' stamp: 'MGD 6/25/2019 09:28:49' overrides: 16917632!
            update: aSection
	self changed: aSection! !
!AnalysisResult methodsFor: 'states' stamp: 'MGD 6/27/2019 10:19:24'!
