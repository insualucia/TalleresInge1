	self organization hasNoComment ifFalse:[^true].
	definition ifNotNil: [ self realClass ifNotNil: [ :realClass | realClass definition = definition ifFalse: [ ^true]]].
	metaClass ifNotNil: [ ^metaClass hasChanges].
	^false! !

