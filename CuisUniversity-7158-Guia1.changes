!FixedGregorianDate methodsFor: 'printing' overrides: 50369851!
                        printOn: aStream

	self month printOn: aStream.
	aStream space.
	dayNumber printOn: aStream.
	aStream nextPut: $,.
	aStream space.
	self year number printOn: aStream! !
!FilteredGregorianDate methodsFor: 'printing' overrides: 50369851!
                    printOn: aStream

	date printOn: aStream! !
!RelativeGregorianDate methodsFor: 'printing' overrides: 50369851!
                 printOn: aStream

	^self absoluteDate printOn: aStream! !
!GregorianDateTime methodsFor: 'printing' stamp: 'HAW 1/15/2019 19:22:59' overrides: 50369851!
       printOn: aStream

	aStream 
		print: date;
		nextPutAll: ' at ';
		print: timeOfDay.
		! !
!GregorianDay methodsFor: 'accessing' overrides: 16917133!
          name
	
	^name! !
!GregorianDay methodsFor: 'printing' overrides: 50369851!
                     printOn: aStream

	aStream nextPutAll: name! !
!GregorianDayOfMonth methodsFor: 'printing' overrides: 50369851!
