!MultiFileSystemCategoryAutoSaver methodsFor: 'file' stamp: 'HAW 7/23/2022 18:56:13' overrides: 50475462!
                         fileName

	^String streamContents: [ :stream |
		stream 
			nextPutAll: categoryName asFileName;
			nextPutAll: '-autosave-';
			nextPutAll: DateAndTime now printStringWithoutOffset asFileName;
			nextPutAll: '.st' ]
! !
