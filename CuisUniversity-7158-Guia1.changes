!AdditionalMethodState methodsFor: '*LiveTyping' stamp: 'HAW 2/27/2019 19:41:49'!
                            initializeTypeInformationUsing: aMethodNode

	self initializeVariablesRawTypesUsing: aMethodNode.
	self initializeReturnRawTypes
