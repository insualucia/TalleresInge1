!DecompilerTestFailuresCollector methodsFor: 'utilities' stamp: 'ul 5/6/2015 16:40'!
         noteFailure: exceptionClass for: method

	(failures ifNil: [ failures := OrderedCollection new ]) add: {
		method methodClass name.
		method selector.
		exceptionClass name }! !
